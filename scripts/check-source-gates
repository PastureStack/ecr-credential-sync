if ! (
  set -euo pipefail
  test "$(wc -l < .gitattributes)" -eq 1
  test "$(git check-attr whitespace -- toolchain/buildx-security.patch)" = \
    'toolchain/buildx-security.patch: whitespace: unset'
  test "$(sha256sum -- toolchain/buildx-security.patch | awk '{print $1}')" = \
    'b615fea76706a4c16e2af354b3a92d7b8b0465dce4f2d2c20b7a87bdc3100ad2'
  git diff --check
); then
  printf 'ECR_SYNC_BUILDX_EMBEDDED_PATCH_BOUNDARY_INVALID\n' >&2
  failure_count=$((failure_count + 1))
fi

if ! go_telemetry_dockerfile_contract Dockerfile.dapper; then
  printf 'ECR_SYNC_GO_TELEMETRY_DOCKERFILE_CONTRACT_INVALID\n' >&2
  failure_count=$((failure_count + 1))
fi

if ! (
  set -euo pipefail
  source_fixture_root=$(mktemp -d)
  case "$source_fixture_root" in
    /tmp/*|/var/tmp/*) ;;
    *) exit 1 ;;
  esac
  trap 'rm -rf -- "$source_fixture_root"' EXIT
  source_fixture="$source_fixture_root/env-only-control.Dockerfile"
  cp Dockerfile.dapper "$source_fixture"
  go_telemetry_dockerfile_contract "$source_fixture"
  printf '\nENV GOTELEMETRY=off\n' >> "$source_fixture"
  if go_telemetry_dockerfile_contract "$source_fixture"; then
    exit 1
  fi
  for source_dir in /tmp/docker-cli-src /tmp/buildx-src; do
    component=${source_dir##*/}
    for mutation in missing late wrong; do
      source_fixture="$source_fixture_root/${component}-${mutation}-cwd.Dockerfile"
      mutate_go_telemetry_cleanup_fixture \
        Dockerfile.dapper "$source_fixture" "$source_dir" "$mutation"
      if go_telemetry_dockerfile_contract "$source_fixture"; then
        exit 1
      fi
    done
  done
); then
  printf 'ECR_SYNC_GO_TELEMETRY_SOURCE_FIXTURE_INVALID\n' >&2
  failure_count=$((failure_count + 1))
fi

