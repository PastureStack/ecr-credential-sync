#!/bin/bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

failure_count=0

require_marker() {
  local file=$1
  local marker=$2
  local code=$3
  if ! grep -F -- "$marker" "$file" >/dev/null; then
    printf '%s file=%s marker=%s\n' "$code" "$file" "$marker" >&2
    failure_count=$((failure_count + 1))
  fi
}

reject_marker() {
  local file=$1
  local marker=$2
  local code=$3
  if grep -F -- "$marker" "$file" >/dev/null; then
    printf '%s file=%s marker=%s\n' "$code" "$file" "$marker" >&2
    failure_count=$((failure_count + 1))
  fi
}

go_telemetry_cleanup_contract() {
  local checker_line=$4
  local cleanup_command=$3
  local dockerfile=$1
  local source_dir=$2

  awk \
    -v checker_line="$checker_line" \
    -v cleanup_command="$cleanup_command" \
    -v source_dir="$source_dir" '
      BEGIN {
        source_line = "    cd " source_dir "; \\"
        safe_line = "    cd /; \\"
        cleanup_line = "    " cleanup_command "; \\"
      }
      {
        line = $0
        sub(/\r$/, "", line)
        if (awaiting_checker) {
          if (line != checker_line) {
            invalid = 1
          } else {
            checker_count++
          }
          awaiting_checker = 0
        }
        if (line == source_line) {
          source_count++
          in_source_block = 1
          post_source_cd_count = 0
        } else if (in_source_block && index(line, "    cd ") == 1) {
          post_source_cd_count++
          if (line != safe_line) {
            invalid = 1
          }
        }
        if (line == cleanup_line) {
          cleanup_count++
          if (!in_source_block || previous != safe_line || post_source_cd_count != 1) {
            invalid = 1
          }
          in_source_block = 0
          awaiting_checker = 1
        }
        previous = line
      }
      END {
        if (source_count != 1 || cleanup_count != 1 || checker_count != 1 ||
            in_source_block || awaiting_checker || invalid) {
          exit 1
        }
      }
    ' "$dockerfile"
}

mutate_go_telemetry_cleanup_fixture() {
  local input=$1
  local mutation=$4
  local output=$2
  local source_dir=$3

  case "$mutation" in
    missing|late|wrong) ;;
    *) return 1 ;;
  esac

  awk -v mutation="$mutation" -v source_dir="$source_dir" '
    BEGIN {
      source_line = "    cd " source_dir "; \\"
      safe_line = "    cd /; \\"
      wrong_line = "    cd /tmp; \\"
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line == source_line) {
        in_source_block = 1
        print line
        next
      }
      if (in_source_block && line == safe_line && changed == 0) {
        changed = 1
        if (mutation == "missing") {
          next
        }
        if (mutation == "wrong") {
          print wrong_line
          next
        }
        pending_late = 1
        next
      }
      if (pending_late && index(line, "    rm -rf " source_dir " ") == 1) {
        print line
        print safe_line
        pending_late = 0
        next
      }
      print line
    }
    END {
      if (changed != 1 || pending_late) {
        exit 1
      }
    }
  ' "$input" > "$output"
}

go_telemetry_dockerfile_contract() {
  local dockerfile=$1
  local first_go_version_line
  local go_telemetry_mode_count
  local go_telemetry_mode_line
  local go_telemetry_off_count
  local go_telemetry_off_line
  local go_telemetry_readback_count

  [ -f "$dockerfile" ] || return 1
  if grep -F -- 'GOTELEMETRY=off' "$dockerfile" >/dev/null; then
    return 1
  fi
  [ "$(grep -Fc -- 'XDG_CONFIG_HOME=/tmp/go-config' "$dockerfile" || true)" -eq 1 ] || return 1
  [ "$(grep -Fc -- 'telemetry_root=/tmp/go-config/go/telemetry' "$dockerfile" || true)" -eq 2 ] || return 1
  [ "$(grep -Fc -- 'date -u --date="@${SOURCE_DATE_EPOCH}"' "$dockerfile" || true)" -eq 2 ] || return 1

  go_telemetry_readback_count=$(grep -Fc -- \
    'bash /usr/local/libexec/pasturestack/check-go-telemetry-state' "$dockerfile" || true)
  [ "$go_telemetry_readback_count" -eq 5 ] || return 1
  go_telemetry_off_count=$(grep -Fc -- '/usr/local/go/bin/go telemetry off' "$dockerfile" || true)
  go_telemetry_mode_count=$(grep -Fc -- \
    "printf 'off %s' \"\${telemetry_mode_date}\" > \"\${telemetry_root}/mode\"" \
    "$dockerfile" || true)
  [ "$go_telemetry_off_count" -eq 1 ] || return 1
  [ "$go_telemetry_mode_count" -eq 1 ] || return 1

  go_telemetry_off_line=$(grep -nF -- '/usr/local/go/bin/go telemetry off' "$dockerfile" | head -n 1 | cut -d: -f1)
  go_telemetry_mode_line=$(grep -nF -- \
    "printf 'off %s' \"\${telemetry_mode_date}\" > \"\${telemetry_root}/mode\"" \
    "$dockerfile" | head -n 1 | cut -d: -f1)
  first_go_version_line=$(grep -nF -- '    go version;' "$dockerfile" | head -n 1 | cut -d: -f1)
  [ -n "$go_telemetry_off_line" ] || return 1
  [ -n "$go_telemetry_mode_line" ] || return 1
  [ -n "$first_go_version_line" ] || return 1
  [ "$go_telemetry_off_line" -lt "$go_telemetry_mode_line" ] || return 1
  [ "$go_telemetry_mode_line" -lt "$first_go_version_line" ] || return 1
  go_telemetry_cleanup_contract \
    "$dockerfile" \
    /tmp/docker-cli-src \
    'rm -rf /tmp/docker-cli-src /tmp/docker-cli.tar.gz /tmp/docker-go-mod /tmp/go-build-cache' \
    '    bash /usr/local/libexec/pasturestack/check-go-telemetry-state /tmp/go-config/go/telemetry "${SOURCE_DATE_EPOCH}" /usr/local/go/bin/go' || return 1
  go_telemetry_cleanup_contract \
    "$dockerfile" \
    /tmp/buildx-src \
    'rm -rf /tmp/buildx-src /tmp/buildx.tar.gz /tmp/buildx-deps.txt /tmp/buildx-patched-go-files.txt /tmp/go-build-cache' \
    '    bash /usr/local/libexec/pasturestack/check-go-telemetry-state /tmp/go-config/go/telemetry "${SOURCE_DATE_EPOCH}" /usr/local/go/bin/go' || return 1
}

brand_source_has_forbidden_reference() {
  local source_root=$1

  # Git controls the source boundary. This includes tracked working-tree edits
  # while excluding untracked build, evidence, cache, bin, and dist artifacts.
  git -C "$source_root" grep -nEi 'rancher' -- \
    . \
    ':(top,exclude)vendor/**' \
    ':(top,exclude)toolchain/buildx-security.patch' \
    ':(top,exclude)scripts/check-source-gates' \
    ':(top,exclude)README.md' \
    ':(top,exclude)ORIGIN.md' \
    ':(top,exclude)COMPATIBILITY.md' \
    ':(top,exclude)THIRD_PARTY_NOTICES.md' \
    ':(top,exclude)UNOFFICIAL_MAINTENANCE_FORK.md'
}

