if [ -e vendor/github.com/aws/aws-sdk-go/service/s3/s3crypto ]; then
  printf 'ECR_SYNC_VULNERABLE_S3_CRYPTO_PACKAGE_VENDORED\n' >&2
  failure_count=$((failure_count + 1))
fi

if grep -RInF --include='*.go' --exclude-dir=vendor \
  'github.com/aws/aws-sdk-go/service/s3/s3crypto' . >/dev/null; then
  printf 'ECR_SYNC_VULNERABLE_S3_CRYPTO_PACKAGE_IMPORTED\n' >&2
  failure_count=$((failure_count + 1))
fi

require_marker .github/workflows/supply-chain.yml \
  'source-go-dependencies.txt' ECR_SYNC_SOURCE_DEPENDENCY_EVIDENCE_MISSING
require_marker .github/workflows/supply-chain.yml \
  'github.com/aws/aws-sdk-go/service/s3/s3crypto' ECR_SYNC_S3_CRYPTO_REACHABILITY_GATE_MISSING

while IFS= read -r workflow; do
  if grep -E '^[[:space:]]*uses:' "$workflow" |
      grep -Ev '@[0-9a-f]{40}([[:space:]]*(#.*)?)?$' >/dev/null; then
    printf 'ECR_SYNC_WORKFLOW_ACTION_NOT_COMMIT_PINNED file=%s\n' "$workflow" >&2
    failure_count=$((failure_count + 1))
  fi
done < <(find .github/workflows -type f \( -name '*.yml' -o -name '*.yaml' \) -print | LC_ALL=C sort)

if [ -e .drone.yml ]; then
  printf 'ECR_SYNC_OBSOLETE_DRONE_WORKFLOW_PRESENT\n' >&2
  failure_count=$((failure_count + 1))
fi

legal_count=$(
  git ls-files 'vendor/**' |
    grep -E '(^|/)(LICENSE[^/]*|NOTICE[^/]*|AUTHORS[^/]*)$' |
    wc -l
)
if [ "$legal_count" -ne 10 ]; then
  printf 'ECR_SYNC_LEGAL_FILE_COUNT_MISMATCH count=%s expected=10\n' "$legal_count" >&2
  failure_count=$((failure_count + 1))
fi

if grep -RInE --exclude-dir=.git --exclude-dir=vendor --exclude=.git \
  --exclude=check-source-gates \
  --exclude=README.md --exclude=ORIGIN.md --exclude=THIRD_PARTY_NOTICES.md \
  '([A-Za-z]:[/\\]Users[/\\]|/Users/[^/]+/|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})' \
  . >/dev/null; then
  printf 'ECR_SYNC_PUBLIC_IDENTITY_OR_PRIVATE_HOST_FOUND\n' >&2
  failure_count=$((failure_count + 1))
fi

if [ -n "${PASTURESTACK_PRIVATE_PATTERN_FILE:-}" ] &&
   [ -f "$PASTURESTACK_PRIVATE_PATTERN_FILE" ] &&
   grep -RInE --exclude-dir=.git --exclude-dir=vendor --exclude=.git \
     --exclude=check-source-gates \
     -f "$PASTURESTACK_PRIVATE_PATTERN_FILE" . >/dev/null; then
  printf 'ECR_SYNC_LOCAL_PRIVATE_PATTERN_FOUND\n' >&2
  failure_count=$((failure_count + 1))
fi

if ! (
  set -euo pipefail
  brand_test_root=$(mktemp -d)
  case "$brand_test_root" in
    /tmp/*|/var/tmp/*) ;;
    *) exit 1 ;;
  esac
  trap 'rm -rf -- "$brand_test_root"' EXIT
  fixture_repo="$brand_test_root/repository"
  mkdir -p "$fixture_repo/evidence"
  git -C "$fixture_repo" init -q
  git -C "$fixture_repo" config core.autocrlf false
  printf 'package fixture\n' > "$fixture_repo/main.go"
  printf 'Rancher compatibility attribution\n' > "$fixture_repo/README.md"
  git -C "$fixture_repo" add main.go README.md

  if brand_source_has_forbidden_reference "$fixture_repo" >/dev/null; then
    exit 1
  elif [ "$?" -ne 1 ]; then
    exit 1
  fi

  printf 'Rancher transient build metadata\n' > "$fixture_repo/evidence/generated.txt"
  if brand_source_has_forbidden_reference "$fixture_repo" >/dev/null; then
    exit 1
  elif [ "$?" -ne 1 ]; then
    exit 1
  fi

  printf 'package fixture // Rancher product reference\n' > "$fixture_repo/main.go"
  if ! brand_source_has_forbidden_reference "$fixture_repo" >/dev/null; then
    exit 1
  fi
); then
  printf 'ECR_SYNC_BRAND_SOURCE_BOUNDARY_CONTRACT_INVALID\n' >&2
  failure_count=$((failure_count + 1))
fi

brand_scan_status=0
if brand_source_has_forbidden_reference "$repo_root" >/dev/null; then
  printf 'ECR_SYNC_BRAND_REFERENCE_OUTSIDE_ATTRIBUTION_FOUND\n' >&2
  failure_count=$((failure_count + 1))
else
  brand_scan_status=$?
  if [ "$brand_scan_status" -ne 1 ]; then
    printf 'ECR_SYNC_BRAND_SOURCE_SCAN_FAILED status=%s\n' "$brand_scan_status" >&2
    failure_count=$((failure_count + 1))
  fi
fi

if grep -RInE --exclude-dir=.git --exclude-dir=vendor --exclude=.git \
  'ghcr\.io/pasturestack/ecr-credential-sync:((latest|main|master)([^[:alnum:]._-]|$)|[^[:space:]]*@sha256:)' \
  README.md COMPATIBILITY.md package scripts main.go internal >/dev/null; then
  printf 'ECR_SYNC_MUTABLE_OR_DIGEST_OPERATIONAL_REFERENCE_FOUND\n' >&2
  failure_count=$((failure_count + 1))
fi

printf 'failure_count=%s\n' "$failure_count"
if [ "$failure_count" -ne 0 ]; then
  exit 1
fi

printf 'ECR_SYNC_SOURCE_GATES_OK go=1.26.6 go_telemetry=off-source-date-epoch-utc go_telemetry_readbacks=5 go_telemetry_cleanup_cwd=two-callers-explicit-root-before-delete docker=29.7.2 docker_cli_source_built=go1.26.6 buildx=0.36.1 dapper_buildx_executable_version=v0.36.1 buildx_go_archive=v0.3.0 buildx_x_mod=v0.40.0 buildx_cves_fixed=3 buildx_patch=sha256:b615fea76706a4c16e2af354b3a92d7b8b0465dce4f2d2c20b7a87bdc3100ad2 jq=1.8.1 jq_package=1.8.1-4ubuntu2 host_buildx=0.36.1 host_buildx_binary=sha256:ebb6935c31ef883684ec1721be8cc7e5d0386e5a445e90b7e81c7c8f5dac991d host_buildx_builds=2-offline-reproducible host_buildkit=0.32.2 buildkit_version_readback=exact-single-record dapper_identity=buildx-iid+metadata-config+daemon-config-or-manifest ubuntu=26.04 snapshot=20260808T000000Z non_root=1 legal_files=%s endpoint_override=bounded brand_gate=tracked_source_only runtime_manifest_access=default-user-read-only buildx_legacy_module_removed=1 embedded_patch_whitespace_scope=exact-path-with-inner-validation runtime_mtime_normalization=all_local_copy_inputs dapper_reproducibility=buildkit-rewrite-timestamp runtime_export=docker-archive-explicit-load runtime_builder=exact-run-owned-pinned sbom_trivy_gate=1\n' \
  "$legal_count"
