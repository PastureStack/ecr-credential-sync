#!/bin/bash
# Modified by PastureStack contributors for independent maintenance and rebranding.
set -euo pipefail

source $(dirname $0)/version

ARCH=${ARCH:?"ARCH not set"}
SUFFIX=""
SCRIPTPATH="$(cd "$(dirname "$0")"; pwd -P)"
[ "${ARCH}" != "amd64" ] && SUFFIX="_${ARCH}"

repo_root=$(cd "${SCRIPTPATH}/.."; pwd -P)
TAG=${TAG:-${VERSION}${SUFFIX}}
REPO=${REPO:-ghcr.io/${IMAGE_NAMESPACE:-pasturestack}}
REVISION=$(git -C "$repo_root" rev-parse HEAD)
SOURCE_DATE_EPOCH=$(git -C "$repo_root" show -s --format=%ct HEAD)
IMAGE=${REPO}/ecr-credential-sync:${TAG}
runtime_result="${repo_root}/dist/runtime-image-build.json"
images_output="${repo_root}/dist/images"
runtime_image_owned=0
runtime_result_created=0
images_output_created=0
runtime_owned_image_id=
staging_owned=0
export SOURCE_DATE_EPOCH

cd "${repo_root}/package"
PACKAGE_DIR=$(pwd -P)

cleanup() {
  local status=$?
  local cleanup_failed=0
  local current_image_id remove_exit
  trap - EXIT
  set +e

  if [ "$status" -ne 0 ] && [ "$runtime_image_owned" -eq 1 ]; then
    current_image_id=$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null)
    if [ "$?" -ne 0 ] || [ "$current_image_id" != "$runtime_owned_image_id" ]; then
      printf 'ECR_SYNC_RUNTIME_PACKAGE_CLEANUP_REFUSED image=%s expected=%s actual=%s\n' \
        "$IMAGE" "$runtime_owned_image_id" "${current_image_id:-unavailable}" >&2
      cleanup_failed=1
    else
      docker image rm "$IMAGE"
      remove_exit=$?
      printf 'ECR_SYNC_RUNTIME_PACKAGE_IMAGE_REMOVE_NATIVE_EXIT=%s image=%s\n' \
        "$remove_exit" "$IMAGE" >&2
      [ "$remove_exit" -eq 0 ] || cleanup_failed=1
    fi
  fi
  if [ "$status" -ne 0 ] && [ "$runtime_result_created" -eq 1 ]; then
    rm -f -- "$runtime_result" || cleanup_failed=1
  fi
  if [ "$status" -ne 0 ] && [ "$images_output_created" -eq 1 ]; then
    rm -f -- "$images_output" || cleanup_failed=1
  fi
  if [ "$staging_owned" -eq 1 ]; then
    rm -f \
      "${PACKAGE_DIR}/ecr-credential-sync" \
      "${PACKAGE_DIR}/LICENSE" \
      "${PACKAGE_DIR}/SECURITY.md" \
      "${PACKAGE_DIR}/ORIGIN.md" \
      "${PACKAGE_DIR}/COMPATIBILITY.md" \
      "${PACKAGE_DIR}/THIRD_PARTY_NOTICES.md" \
      "${PACKAGE_DIR}/ubuntu-apt.lock" || cleanup_failed=1
    rm -rf -- "${PACKAGE_DIR}/licenses" || cleanup_failed=1
  fi

  if [ "$status" -eq 0 ] && [ "$cleanup_failed" -ne 0 ]; then
    status=1
  fi
  exit "$status"
}
trap cleanup EXIT

for staged_path in \
    ecr-credential-sync LICENSE SECURITY.md ORIGIN.md COMPATIBILITY.md \
    THIRD_PARTY_NOTICES.md ubuntu-apt.lock licenses; do
  [ ! -e "${PACKAGE_DIR}/${staged_path}" ] && [ ! -L "${PACKAGE_DIR}/${staged_path}" ] || {
    printf 'package staging path already exists: %s\n' "${PACKAGE_DIR}/${staged_path}" >&2
    exit 1
  }
done
mkdir -p "${repo_root}/dist"
[ ! -e "$runtime_result" ] && [ ! -L "$runtime_result" ] || {
  printf 'runtime result already exists: %s\n' "$runtime_result" >&2
  exit 1
}
[ ! -e "$images_output" ] && [ ! -L "$images_output" ] || {
  printf 'image list already exists: %s\n' "$images_output" >&2
  exit 1
}
staging_owned=1

cp ../bin/ecr-credential-sync .
cp \
  ../LICENSE \
  ../SECURITY.md \
  ../ORIGIN.md \
  ../COMPATIBILITY.md \
  ../THIRD_PARTY_NOTICES.md \
  ../ubuntu-apt.lock \
  .

legal_count=0
while IFS= read -r legal_file; do
  target="licenses/third-party/${legal_file#vendor/}"
  install -D -m 0644 "../${legal_file}" "$target"
  legal_count=$((legal_count + 1))
done < <(
  git -C .. ls-files 'vendor/**' |
    grep -E '(^|/)(LICENSE[^/]*|NOTICE[^/]*|AUTHORS[^/]*)$' |
    LC_ALL=C sort
)
test "$legal_count" -eq 10

if [ "$SOURCE_DATE_EPOCH" -gt "$(date -u +%s)" ]; then
  printf 'SOURCE_DATE_EPOCH is in the future: %s\n' "$SOURCE_DATE_EPOCH" >&2
  exit 1
fi
bash "${SCRIPTPATH}/normalize-runtime-context-mtimes" \
  "${PACKAGE_DIR}/Dockerfile" \
  "${PACKAGE_DIR}" \
  "${SOURCE_DATE_EPOCH}"

bash "${SCRIPTPATH}/build-runtime-image" build \
  "$IMAGE" \
  "$PACKAGE_DIR" \
  "${PACKAGE_DIR}/Dockerfile" \
  "$SOURCE_DATE_EPOCH" \
  "${UBUNTU_APT_SNAPSHOT:-20260808T000000Z}" \
  "$TAG" \
  "$REVISION" \
  "${DOCKER_BUILD_NETWORK:-host}" \
  "$runtime_result"
runtime_result_created=1
runtime_image_owned=1
runtime_owned_image_id=$(jq -er '.imageId' "$runtime_result")
[[ "$runtime_owned_image_id" =~ ^sha256:[0-9a-f]{64}$ ]]
(
  set -o noclobber
  printf '%s\n' "$IMAGE" >"$images_output"
)
images_output_created=1
printf 'Built %s\n' "$IMAGE"

package() {
  local os arch suffix tag repo env image_name binary_name
  os=$1
  arch=$2
  image_name="ecr-credential-sync"
  binary_name="ecr-credential-sync"
  if [ "${WINDOWS_DOCKER_HOST:-}" == "" -a "$os" == "windows" ]; then
      echo "WINDOWS_DOCKER_HOST is not set, skip packaging Windows image"
      return
  fi
  [ "$os"   == "windows" ] && binary_name="${binary_name}.exe"
  [ "$os"   != "linux" ] && image_name="${image_name}-${os}"
  [ "$arch" != "amd64" ] && suffix="${suffix}_${arch}"
  
  tag="${TAG:-${VERSION}${SUFFIX}}"

  if [ ! -d "package/$os/$arch" ]; then 
      echo "Directory package/$os/$arch not exist, skip package"
      return
  fi
  cp bin/$os/$arch/$binary_name package/$os/$arch
  bash "$SCRIPTPATH/normalize-runtime-context-mtimes" \
    "package/$os/$arch/Dockerfile" \
    "package/$os/$arch" \
    "$SOURCE_DATE_EPOCH"

  # because if building windows image, need to connect to docker on windows. set DOCKER_HOST for docker build context
  [ "$os" == "windows" ] && dhost="tcp://$WINDOWS_DOCKER_HOST:2375" || dhost="${DOCKER_HOST:-}"
  DOCKER_HOST=$dhost docker build -t ${REPO}/${image_name}:${tag} -f package/$os/$arch/Dockerfile package/$os/$arch

  echo ${REPO}/${image_name}:${tag} >> dist/images
  echo Built ${REPO}/${image_name}:${tag}
}

source $SCRIPTPATH/version
cd $SCRIPTPATH/..

if [ -n "${CROSS:-}" ]; then
    for os in $(ls bin); do
        for arch in $(ls bin/$os); do
            package $os $arch
        done
    done
fi

runtime_image_owned=0
