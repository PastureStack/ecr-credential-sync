#!/bin/bash
set -euo pipefail

if [ "$#" -ne 5 ]; then
  printf 'usage: %s METADATA_FILE IID_FILE DAEMON_IMAGE_ID MANIFEST_OUTPUT CONFIG_OUTPUT\n' "$0" >&2
  exit 64
fi

metadata_file=$1
iid_file=$2
daemon_image_id=$3
manifest_output=$4
config_output=$5
digest_pattern='^sha256:[0-9a-f]{64}$'

fail() {
  printf 'ECR_SYNC_DAPPER_IMAGE_IDENTITY_INVALID reason=%s\n' "$1" >&2
  exit 1
}

jq_path=$(command -v jq 2>/dev/null) || fail jq-not-found
case "$jq_path" in
  /*) ;;
  *) fail jq-path-not-absolute ;;
esac
jq_version=$(jq --version 2>/dev/null) || fail jq-version-unavailable
[[ "$jq_version" =~ ^jq-[0-9]+([.][0-9]+){1,2}([.-][-0-9A-Za-z.+~_]+)?$ ]] || \
  fail malformed-jq-version

for required_file in "$metadata_file" "$iid_file"; do
  [ -f "$required_file" ] || fail "missing-file:${required_file}"
done

for output_file in "$manifest_output" "$config_output"; do
  [ ! -e "$output_file" ] || fail "output-already-exists:${output_file}"
  [ -d "$(dirname "$output_file")" ] || fail "missing-output-directory:${output_file}"
done
[ "$manifest_output" != "$config_output" ] || fail output-paths-must-be-distinct

mapfile -t iid_lines < "$iid_file"
[ "${#iid_lines[@]}" -eq 1 ] || fail iid-file-must-contain-one-line
iid_digest=${iid_lines[0]}
[[ "$iid_digest" =~ $digest_pattern ]] || fail malformed-iid-digest
[[ "$daemon_image_id" =~ $digest_pattern ]] || fail malformed-daemon-image-id

manifest_digest=$(
  jq -er '
    if type != "object" then
      error("metadata root must be an object")
    elif (."containerimage.digest" | type) == "string" and
         (."containerimage.digest" | test("^sha256:[0-9a-f]{64}$")) then
      ."containerimage.digest"
    else
      error("containerimage.digest is missing or malformed")
    end
  ' "$metadata_file"
) || fail missing-or-malformed-manifest-digest
[[ "$manifest_digest" =~ $digest_pattern ]] || fail malformed-manifest-digest

top_level_config_record=$(
  jq -ec '
    if type != "object" then
      error("metadata root must be an object")
    elif has("containerimage.config.digest") and
         ."containerimage.config.digest" != null then
      if (."containerimage.config.digest" | type) == "string" then
        {present: true, digest: ."containerimage.config.digest"}
      else
        error("containerimage.config.digest must be a string or null")
      end
    else
      {present: false}
    end
  ' "$metadata_file"
) || fail malformed-top-level-config-digest

descriptor_config_record=$(
  jq -ec '
    ."containerimage.descriptor" as $descriptor
    | if $descriptor == null then
        {present: false}
      elif ($descriptor | type) != "object" then
        error("containerimage.descriptor must be an object or null")
      elif $descriptor.annotations == null then
        {present: false}
      elif ($descriptor.annotations | type) != "object" then
        error("containerimage.descriptor.annotations must be an object or null")
      elif ($descriptor.annotations | has("config.digest")) and
           $descriptor.annotations["config.digest"] != null then
        if ($descriptor.annotations["config.digest"] | type) == "string" then
          {present: true, digest: $descriptor.annotations["config.digest"]}
        else
          error("descriptor config.digest must be a string or null")
        end
      else
        {present: false}
      end
  ' "$metadata_file"
) || fail malformed-descriptor-config-digest

top_level_present=$(jq -r '.present | if type == "boolean" then . else error("invalid") end' \
  <<<"$top_level_config_record") || fail malformed-metadata-config-record
descriptor_present=$(jq -r '.present | if type == "boolean" then . else error("invalid") end' \
  <<<"$descriptor_config_record") || fail malformed-metadata-config-record
case "$top_level_present:$descriptor_present" in
  true:true|true:false|false:true|false:false) ;;
  *) fail malformed-metadata-config-record ;;
esac

top_level_config=
descriptor_config=
metadata_cross_checks=0
if [ "$top_level_present" = true ]; then
  top_level_config=$(jq -er '.digest | if type == "string" then . else error("invalid") end' \
    <<<"$top_level_config_record") || fail malformed-metadata-config-record
  [[ "$top_level_config" =~ $digest_pattern ]] || fail malformed-metadata-config-digest
fi
if [ "$descriptor_present" = true ]; then
  descriptor_config=$(jq -er '.digest | if type == "string" then . else error("invalid") end' \
    <<<"$descriptor_config_record") || fail malformed-metadata-config-record
  [[ "$descriptor_config" =~ $digest_pattern ]] || fail malformed-metadata-config-digest
fi
if [ -n "$top_level_config" ] && [ -n "$descriptor_config" ]; then
  [ "$top_level_config" = "$descriptor_config" ] || fail metadata-config-digest-conflict
fi

config_digest=${top_level_config:-$descriptor_config}
[ -n "$config_digest" ] || fail missing-metadata-config-digest
[ -z "$top_level_config" ] || metadata_cross_checks=$((metadata_cross_checks + 1))
[ -z "$descriptor_config" ] || metadata_cross_checks=$((metadata_cross_checks + 1))

if [ "$daemon_image_id" = "$config_digest" ]; then
  daemon_id_mode=config-digest
elif [ "$daemon_image_id" = "$manifest_digest" ]; then
  daemon_id_mode=manifest-digest
else
  fail daemon-image-id-unrecognized
fi

if [ "$top_level_present" = true ]; then
  [ "$iid_digest" = "$top_level_config" ] || fail metadata-iid-config-digest-mismatch
  iid_mode=config-digest
else
  [ "$iid_digest" = "$manifest_digest" ] || fail iid-manifest-digest-mismatch
  iid_mode=manifest-fallback
fi

umask 077
printf '%s\n' "$manifest_digest" > "$manifest_output"
printf '%s\n' "$config_digest" > "$config_output"
printf 'ECR_SYNC_DAPPER_IMAGE_IDENTITY_OK manifest=%s config=%s iid=%s iid_mode=%s daemon_id=%s daemon_id_mode=%s metadata_cross_checks=%s\n' \
  "$manifest_digest" "$config_digest" "$iid_digest" "$iid_mode" \
  "$daemon_image_id" "$daemon_id_mode" "$metadata_cross_checks"
