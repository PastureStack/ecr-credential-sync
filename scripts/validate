#!/bin/bash
set -euo pipefail

cd $(dirname $0)/..

echo Running validation

PACKAGES=$(go list -mod=vendor ./... | grep -Ev '(/vendor/|/mocks$)' || true)

echo Running: go vet
go vet -mod=vendor ${PACKAGES}
echo Running: go fmt
unformatted=$(find . -name '*.go' \
  -not -path './vendor/*' \
  -not -path './.git/*' \
  -not -path './bin/*' \
  -print0 | xargs -0 gofmt -l)
if [ -n "${unformatted}" ]; then
  printf '%s\n' "${unformatted}" >&2
  exit 1
fi
