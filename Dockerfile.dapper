ARG UBUNTU_IMAGE=ubuntu:26.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03

FROM ${UBUNTU_IMAGE} AS snapshot-ca-bootstrap

ARG SOURCE_DATE_EPOCH

ADD --checksum=sha256:6077d27c6b6f8b23590cb01ff877ed8c804a67a5442cc32b5a33da10d2bd0e90 \
    https://snapshot.ubuntu.com/ubuntu/20260808T000000Z/pool/main/c/ca-certificates/ca-certificates_20260601~26.04.1_all.deb \
    /tmp/ca-certificates.deb

RUN set -eux; \
    rm -rf /tmp/ca-bootstrap; \
    mkdir -p /tmp/ca-bootstrap; \
    dpkg-deb --extract /tmp/ca-certificates.deb /tmp/ca-bootstrap; \
    find /tmp/ca-bootstrap/usr/share/ca-certificates -type f -name '*.crt' \
        | LC_ALL=C sort \
        | while IFS= read -r certificate; do sed -e '$a\' "${certificate}"; done \
        > /snapshot-ca-certificates.crt; \
    test -s /snapshot-ca-certificates.crt; \
    case "${SOURCE_DATE_EPOCH}" in ''|*[!0-9]*) exit 64 ;; esac; \
    touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" /snapshot-ca-certificates.crt

FROM ${UBUNTU_IMAGE}

# Modified by PastureStack contributors for independent maintenance and rebranding.

ARG SOURCE_DATE_EPOCH

COPY --from=snapshot-ca-bootstrap /snapshot-ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY ubuntu-apt.lock /usr/share/pasturestack/manifests/ubuntu-apt.lock
COPY toolchain/buildx-security.patch /usr/share/pasturestack/patches/buildx-security.patch

RUN set -eux; \
    case "${SOURCE_DATE_EPOCH}" in ''|*[!0-9]*) exit 64 ;; esac; \
    test "${SOURCE_DATE_EPOCH}" -le "$(date -u +%s)"; \
    touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" \
        /etc/ssl/certs/ca-certificates.crt \
        /usr/share/pasturestack/manifests/ubuntu-apt.lock \
        /usr/share/pasturestack/patches/buildx-security.patch

ARG DAPPER_HOST_ARCH=amd64
ARG GO_VERSION=1.26.6
ARG DOCKER_VERSION=29.7.2
ARG DOCKER_GIT_COMMIT=a7dcaa6fdb6ed04aacbfdc76357fdae01605609e
ARG DOCKER_SOURCE_DATE_EPOCH=1785922455
ARG DOCKER_SOURCE_SHA256=6e5c91d3a5a79db78cf989d07727d00e757aa0da4d135a3ce4b86061b83fb511
ARG DOCKER_X_TEXT_VERSION=v0.40.0
ARG DOCKER_GRPC_VERSION=v1.82.1
ARG BUILDX_VERSION=0.36.1
ARG BUILDX_GIT_COMMIT=1d8dde89b8aba914e05e45366770736fea1fd690
ARG BUILDX_SOURCE_DATE_EPOCH=1785856317
ARG BUILDX_SOURCE_SHA256=fb28b5c2a198d05482f0656dfb7ee161240a904e36697bf7108e5d517f23854b
ARG BUILDX_SECURITY_PATCH_SHA256=9d424e752f24ea0e34ccd80340428f067ae8109204c401c93786a2b0be6ea993
ARG UBUNTU_APT_SNAPSHOT=20260808T000000Z
ARG GO_LINUX_AMD64_SHA256=708effb774be8237570d0add163225abbdfaf4fca28b2611df167beba4feef89
ARG GO_LINUX_ARM64_SHA256=d0507e9e9d7fe012aae570108cbd76c15de879e17130ab8cb90d4d7445cb1f2e

ENV HOST_ARCH=${DAPPER_HOST_ARCH} ARCH=${DAPPER_HOST_ARCH}
ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    . /usr/share/pasturestack/manifests/ubuntu-apt.lock; \
    test "${UBUNTU_APT_SNAPSHOT}" = "${UBUNTU_APT_LOCKED_SNAPSHOT}"; \
    rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; \
    printf 'Types: deb\nURIs: https://snapshot.ubuntu.com/ubuntu/%s\nSuites: resolute resolute-updates resolute-backports resolute-security\nComponents: main universe restricted multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\nSnapshot: no\n' \
        "${UBUNTU_APT_SNAPSHOT}" > /etc/apt/sources.list.d/pasturestack-snapshot.sources; \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\nAcquire::http::Pipeline-Depth "0";\nAcquire::https::CaInfo "/etc/ssl/certs/ca-certificates.crt";\nAcquire::https::Verify-Peer "true";\nAcquire::https::Verify-Host "true";\nAcquire::AllowInsecureRepositories "false";\nAPT::Get::AllowUnauthenticated "false";\n' \
        > /etc/apt/apt.conf.d/80pasturestack-snapshot; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash="${UBUNTU_APT_BASH_VERSION}" \
        ca-certificates="${UBUNTU_APT_CA_CERTIFICATES_VERSION}" \
        curl="${UBUNTU_APT_CURL_VERSION}" \
        gcc="${UBUNTU_APT_GCC_VERSION}" \
        git="${UBUNTU_APT_GIT_VERSION}" \
        jq="${UBUNTU_APT_JQ_VERSION}" \
        libc6-dev="${UBUNTU_APT_LIBC6_DEV_VERSION}" \
        make="${UBUNTU_APT_MAKE_VERSION}" \
        tar="${UBUNTU_APT_TAR_VERSION}" \
        xz-utils="${UBUNTU_APT_XZ_UTILS_VERSION}"; \
    for package_and_version in \
        "bash=${UBUNTU_APT_BASH_VERSION}" \
        "ca-certificates=${UBUNTU_APT_CA_CERTIFICATES_VERSION}" \
        "curl=${UBUNTU_APT_CURL_VERSION}" \
        "gcc=${UBUNTU_APT_GCC_VERSION}" \
        "git=${UBUNTU_APT_GIT_VERSION}" \
        "jq=${UBUNTU_APT_JQ_VERSION}" \
        "libc6-dev=${UBUNTU_APT_LIBC6_DEV_VERSION}" \
        "make=${UBUNTU_APT_MAKE_VERSION}" \
        "tar=${UBUNTU_APT_TAR_VERSION}" \
        "xz-utils=${UBUNTU_APT_XZ_UTILS_VERSION}"; do \
        package="${package_and_version%%=*}"; \
        expected="${package_and_version#*=}"; \
        test "$(dpkg-query -W -f='${Version}' "${package}")" = "${expected}"; \
    done; \
    test "$(jq --version)" = "jq-1.8.1"; \
    { \
        printf 'record\tname\tarchitecture\tversion\n'; \
        printf 'metadata\tschema\t-\tpasturestack.dpkg-manifest/v1\n'; \
        printf 'metadata\tubuntu_snapshot\t-\t%s\n' "${UBUNTU_APT_SNAPSHOT}"; \
        dpkg-query -W -f='package\t${binary:Package}\t${Architecture}\t${Version}\n' | LC_ALL=C sort; \
    } > /usr/share/pasturestack/manifests/dapper-ubuntu-packages.tsv; \
    touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" \
        /usr/share/pasturestack/manifests/dapper-ubuntu-packages.tsv; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/*; \
    rm -f /var/log/apt/* /var/log/dpkg.log /var/log/alternatives.log /var/cache/ldconfig/aux-cache; \
    rm -f /usr/bin/pebble; \
    rm -f /bin/sh && ln -s /bin/bash /bin/sh

ENV GOPATH=/go \
    PATH=/go/bin:/usr/local/go/bin:${PATH} \
    SHELL=/bin/bash \
    GO111MODULE=off \
    GO15VENDOREXPERIMENT=1 \
    GOCACHE=/tmp/go-build-cache \
    GOTELEMETRY=off \
    XDG_CONFIG_HOME=/tmp/go-config \
    GIT_CONFIG_GLOBAL=/tmp/gitconfig

RUN set -eux; \
    case "${DAPPER_HOST_ARCH}" in \
        amd64) go_arch=amd64; go_sha="${GO_LINUX_AMD64_SHA256}" ;; \
        arm64) go_arch=arm64; go_sha="${GO_LINUX_ARM64_SHA256}" ;; \
        *) echo "unsupported DAPPER_HOST_ARCH=${DAPPER_HOST_ARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 10 --max-time 300 \
        -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz"; \
    echo "${go_sha}  /tmp/go.tgz" | sha256sum -c -; \
    tar -xzf /tmp/go.tgz -C /usr/local; \
    rm -f /tmp/go.tgz; \
    go version

RUN set -eux; \
    docker_source_uri="https://codeload.github.com/docker/cli/tar.gz/${DOCKER_GIT_COMMIT}"; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 10 --max-time 300 \
        -o /tmp/docker-cli.tar.gz "${docker_source_uri}"; \
    echo "${DOCKER_SOURCE_SHA256}  /tmp/docker-cli.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/docker-cli-src; \
    tar -xzf /tmp/docker-cli.tar.gz -C /tmp/docker-cli-src --strip-components=1; \
    cd /tmp/docker-cli-src; \
    grep -F "golang.org/x/text ${DOCKER_X_TEXT_VERSION}" vendor.mod; \
    grep -F "google.golang.org/grpc ${DOCKER_GRPC_VERSION}" vendor.mod; \
    cp vendor.mod go.mod; \
    cp vendor.sum go.sum; \
    GO111MODULE=on GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org GOMODCACHE=/tmp/docker-go-mod go mod download; \
    GO111MODULE=on GOPROXY=off GOSUMDB=sum.golang.org GOMODCACHE=/tmp/docker-go-mod go mod verify; \
    docker_build_time="$(date -u --date="@${DOCKER_SOURCE_DATE_EPOCH}" +'%Y-%m-%dT%H:%M:%SZ')"; \
    SOURCE_DATE_EPOCH="${DOCKER_SOURCE_DATE_EPOCH}" CGO_ENABLED=0 GO111MODULE=on GOPROXY=off GOSUMDB=sum.golang.org GOMODCACHE=/tmp/docker-go-mod GOOS=linux GOARCH="${DAPPER_HOST_ARCH}" \
        go build -mod=mod -trimpath -buildvcs=false -tags 'grpcnotrace osusergo netgo' \
        -ldflags "-s -w -buildid= -X github.com/docker/cli/cli/version.Version=${DOCKER_VERSION} -X github.com/docker/cli/cli/version.GitCommit=${DOCKER_GIT_COMMIT} -X github.com/docker/cli/cli/version.BuildTime=${docker_build_time}" \
        -o /usr/bin/docker ./cmd/docker; \
    chmod +x /usr/bin/docker; \
    docker --version | grep -F "Docker version ${DOCKER_VERSION},"; \
    go version -m /usr/bin/docker > /usr/share/pasturestack/manifests/docker-cli-go-version.txt; \
    docker_compiler="$(awk 'NR == 1 { print $NF }' /usr/share/pasturestack/manifests/docker-cli-go-version.txt)"; \
    test "${docker_compiler}" = "go${GO_VERSION}"; \
    grep -F $'dep\tgolang.org/x/text\t'"${DOCKER_X_TEXT_VERSION}"$'\t' /usr/share/pasturestack/manifests/docker-cli-go-version.txt; \
    grep -F $'dep\tgoogle.golang.org/grpc\t'"${DOCKER_GRPC_VERSION}"$'\t' /usr/share/pasturestack/manifests/docker-cli-go-version.txt; \
    { \
        printf 'component\tdeclared_version\tsource_uri\tsource_commit\tsource_sha256\tsource_date_epoch\tcompiler\ttarget\tinstalled_sha256\tinstalled_version\tbuild_flags\n'; \
        printf 'docker-cli\t%s\t%s\t%s\t%s\t%s\tgo%s\tlinux-%s\t%s\t%s\t%s\n' \
            "${DOCKER_VERSION}" "${docker_source_uri}" "${DOCKER_GIT_COMMIT}" "${DOCKER_SOURCE_SHA256}" "${DOCKER_SOURCE_DATE_EPOCH}" \
            "${docker_compiler#go}" "${DAPPER_HOST_ARCH}" "$(sha256sum /usr/bin/docker | awk '{ print $1 }')" "$(docker --version)" \
            '-mod=mod -trimpath -buildvcs=false -tags=grpcnotrace,osusergo,netgo -ldflags=-s,-w,-buildid='; \
    } > /usr/share/pasturestack/manifests/docker-cli-build.tsv; \
    touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" \
        /usr/bin/docker \
        /usr/share/pasturestack/manifests/docker-cli-build.tsv \
        /usr/share/pasturestack/manifests/docker-cli-go-version.txt; \
    rm -rf /tmp/docker-cli-src /tmp/docker-cli.tar.gz /tmp/docker-go-mod /tmp/go-build-cache

RUN set -eux; \
    buildx_source_uri="https://codeload.github.com/docker/buildx/tar.gz/${BUILDX_GIT_COMMIT}"; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 10 --max-time 300 \
        -o /tmp/buildx.tar.gz "${buildx_source_uri}"; \
    echo "${BUILDX_SOURCE_SHA256}  /tmp/buildx.tar.gz" | sha256sum -c -; \
    echo "${BUILDX_SECURITY_PATCH_SHA256}  /usr/share/pasturestack/patches/buildx-security.patch" | sha256sum -c -; \
    mkdir -p /tmp/buildx-src /usr/libexec/docker/cli-plugins; \
    tar -xzf /tmp/buildx.tar.gz -C /tmp/buildx-src --strip-components=1; \
    cd /tmp/buildx-src; \
    git apply --check /usr/share/pasturestack/patches/buildx-security.patch; \
    git apply /usr/share/pasturestack/patches/buildx-security.patch; \
    GO111MODULE=on GOPROXY=off GOSUMDB=sum.golang.org go list -mod=vendor -deps ./cmd/buildx > /tmp/buildx-deps.txt; \
    if grep '^github.com/docker/docker/' /tmp/buildx-deps.txt; then \
        echo 'patched Buildx still compiles github.com/docker/docker' >&2; \
        exit 1; \
    fi; \
    SOURCE_DATE_EPOCH="${BUILDX_SOURCE_DATE_EPOCH}" CGO_ENABLED=0 GO111MODULE=on GOPROXY=off GOSUMDB=sum.golang.org GOOS=linux GOARCH="${DAPPER_HOST_ARCH}" \
        go build -mod=vendor -trimpath -buildvcs=false \
        -ldflags "-s -w -buildid= -X github.com/docker/buildx/version.Version=v${BUILDX_VERSION} -X github.com/docker/buildx/version.Revision=${BUILDX_GIT_COMMIT} -X github.com/docker/buildx/version.Package=github.com/docker/buildx" \
        -o /usr/libexec/docker/cli-plugins/docker-buildx ./cmd/buildx; \
    chmod +x /usr/libexec/docker/cli-plugins/docker-buildx; \
    docker buildx version; \
    go version -m /usr/libexec/docker/cli-plugins/docker-buildx > /usr/share/pasturestack/manifests/buildx-go-version.txt; \
    if grep -F $'dep\tgithub.com/docker/docker\t' /usr/share/pasturestack/manifests/buildx-go-version.txt; then \
        echo 'patched Buildx binary still records github.com/docker/docker' >&2; \
        exit 1; \
    fi; \
    touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" \
        /usr/libexec/docker/cli-plugins/docker-buildx \
        /usr/share/pasturestack/manifests/buildx-go-version.txt; \
    rm -rf /tmp/buildx-src /tmp/buildx.tar.gz /tmp/buildx-deps.txt /tmp/go-build-cache

RUN set -eux; \
    . /usr/share/pasturestack/manifests/ubuntu-apt.lock; \
    { \
        printf 'component\tdeclared_version\ttarget\tinstalled_sha256\tinstalled_version\n'; \
        printf 'gcc\t%s\tlinux-%s\t%s\t%s\n' \
            "$(dpkg-query -W -f='${Version}' gcc)" "${DAPPER_HOST_ARCH}" \
            "$(sha256sum /usr/bin/gcc | awk '{ print $1 }')" "$(gcc -dumpfullversion -dumpversion)"; \
        printf 'go\t%s\tlinux-%s\t%s\t%s\n' \
            "${GO_VERSION}" "${DAPPER_HOST_ARCH}" \
            "$(sha256sum /usr/local/go/bin/go | awk '{ print $1 }')" "$(go version)"; \
        printf 'docker\t%s\tlinux-%s\t%s\t%s\n' \
            "${DOCKER_VERSION}" "${DAPPER_HOST_ARCH}" \
            "$(sha256sum /usr/bin/docker | awk '{ print $1 }')" "$(docker --version)"; \
        printf 'buildx\t%s\tlinux-%s\t%s\t%s\n' \
            "${BUILDX_VERSION}" "${DAPPER_HOST_ARCH}" \
            "$(sha256sum /usr/libexec/docker/cli-plugins/docker-buildx | awk '{ print $1 }')" "$(docker buildx version)"; \
        printf 'jq\t%s\tlinux-%s\t%s\t%s\n' \
            "${UBUNTU_APT_JQ_VERSION}" "${DAPPER_HOST_ARCH}" \
            "$(sha256sum /usr/bin/jq | awk '{ print $1 }')" "$(jq --version)"; \
    } > /usr/share/pasturestack/manifests/dapper-toolchain.tsv; \
    touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" \
        /usr/share/pasturestack/manifests/dapper-toolchain.tsv

ENV DAPPER_SOURCE=/go/src/github.com/PastureStack/ecr-credential-sync/
ENV DAPPER_OUTPUT="./bin ./dist"
ENV DAPPER_DOCKER_SOCKET=true
ENV DAPPER_ENV="TAG REPO IMAGE_NAMESPACE VERSION_OVERRIDE CROSS WINDOWS_DOCKER_HOST DOCKER_BUILD_NETWORK RUNTIME_IMAGE_BUILD_TOKEN"
ENV HOME=${DAPPER_SOURCE}
WORKDIR ${DAPPER_SOURCE}

RUN set -eux; \
    git config --system --add safe.directory ${DAPPER_SOURCE}; \
    touch --no-dereference --date="@${SOURCE_DATE_EPOCH}" /etc/gitconfig

ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]
